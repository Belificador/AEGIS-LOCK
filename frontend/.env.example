# Leave blank for simulated JS authentication. Configure to use REST, e.g.
# VITE_AUTH_API_URL=http://127.0.0.1:8000/api/login
VITE_AUTH_API_URL=

# Optional authenticated WebSocket, e.g. ws://127.0.0.1:8000/ws/dashboard
VITE_WS_URL=

# Optional local video URLs, one per camera. Leave unset until streams exist.
# VITE_CAMERA_1_URL=http://127.0.0.1:9001/camera-1.mp4
# VITE_CAMERA_2_URL=http://127.0.0.1:9001/camera-2.mp4
# VITE_CAMERA_3_URL=http://127.0.0.1:9001/camera-3.mp4
# VITE_CAMERA_4_URL=http://127.0.0.1:9001/camera-4.mp4
# VITE_CAMERA_5_URL=http://127.0.0.1:9001/camera-5.mp4
# VITE_CAMERA_6_URL=http://127.0.0.1:9001/camera-6.mp4
# VITE_CAMERA_7_URL=http://127.0.0.1:9001/camera-7.mp4
