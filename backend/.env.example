ENVIRONMENT=local
AEGIS_SERVICE_ROLE=api
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PIN_ENCRYPTION_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RATE_LIMIT_STORAGE_URI=memory://
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# PostgreSQL URL. On Render use the database's Internal Database URL.
# DATABASE_URL=postgresql://user:password@host/database

# Shared only between the Render simulator server and this backend.
# Generate a random value of at least 32 characters; never put it in browser code.
# TELEMETRY_API_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Public Render origin of the gemelo; video links are short-lived HMAC signatures.
GEMELO_MEDIA_BASE_URL=https://gemelo-digital-bhjp.onrender.com

# Unique account passwords of at least 16 characters. Keep only in this ignored
# local file or Render secrets. Never put passwords in frontend code.
# DEMO_OPERATOR_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# JSON array of the exact local browser origins used by Vite.
ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Optional public site URL and service title for OpenRouter attribution headers.
# OPENROUTER_SITE_URL=https://aegis-lock.onrender.com
OPENROUTER_APP_NAME=AEGIS LOCK - ARGUS

# Telegram bot used for Hermes replies and Argus notifications.
# Single default report/alert destination (numeric private chat ID).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Authorized private Telegram IDs; optionally link each ID to an AEGIS username.
# Bare IDs are read-only operators. Example: 123456789,987654321:admin
TELEGRAM_USER_MAP=
# Random 32+ character secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Explicit voltage alarm band and consecutive out-of-range samples before warning.
VOLTAGE_NORMAL_MIN_V=110
VOLTAGE_NORMAL_MAX_V=220
VOLTAGE_FLUCTUATION_SAMPLES=3
ARGUS_REPORT_TIMEZONE=UTC
# GitHub Actions daily report uses an external read-only PostgreSQL URL in its repository secret.
# ARGUS_REPORT_DATABASE_URL=postgresql://argus_reader:...@host/database
