ENVIRONMENT=local
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# PostgreSQL URL. On Render use the database's Internal Database URL.
# DATABASE_URL=postgresql://user:password@host/database

# Shared only between the Render simulator server and this backend.
# Generate a random value of at least 32 characters; never put it in browser code.
# TELEMETRY_API_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Public Render origin of the gemelo; video links are short-lived HMAC signatures.
GEMELO_MEDIA_BASE_URL=https://gemelo-digital-bhjp.onrender.com

# Existing demo account passwords. Set these as secrets on Render.
# They are hashed before being written to PostgreSQL.
# DEMO_OPERATOR_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# JSON array of the exact local browser origins used by Vite.
ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Argus chat and scheduled report generation. Keep the API key server-side.
# OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_APP_NAME=AEGIS LOCK - ARGUS

# Hermes Telegram webhook: map private Telegram numeric IDs to AEGIS usernames.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-value-of-at-least-32-characters
# TELEGRAM_USER_MAP=123456789:operador,987654321:admin

# Argus daily report job configuration.
# TELEGRAM_CHAT_ID=
ARGUS_REPORT_TIMEZONE=UTC
# ARGUS_REPORT_DATABASE_URL=postgresql://readonly_user:...@host/database
