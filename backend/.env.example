ENVIRONMENT=local
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15

# Server-side Supabase service role key. Never place this key in frontend/.env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-server-side-supabase-service-role-key

# JSON array of the exact local browser origins used by Vite.
ALLOWED_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Optional OpenAI-compatible local model endpoint (e.g. Ollama).
# LOCAL_AI_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.2
